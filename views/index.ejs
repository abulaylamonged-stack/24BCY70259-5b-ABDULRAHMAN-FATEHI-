<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Student Management</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container py-5">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Student Management System</h1>
    <a href="/add" class="btn btn-primary">New Student</a>
  </div>

  <!-- Student Cards -->
  <% students.forEach(student => { %>
    <div class="card mb-4 shadow-sm">
      <div class="card-body">

        <h4 class="card-title fw-bold"><%= student.name %></h4>
        <p class="text-muted">Roll: <%= student._id.toString().slice(-3) %></p>

        <hr>

        <div class="d-flex justify-content-end gap-2">
          <a href="/edit/<%= student._id %>" class="btn btn-outline-primary btn-sm">Edit</a>

          <form action="/delete/<%= student._id %>" method="POST">
            <button class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>

      </div>
    </div>
  <% }) %>

</div>

</body>
</html>